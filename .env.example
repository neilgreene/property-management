# Copy to .env, or paste these into Portainer's stack environment panel.
#
#   cp .env.example .env && docker compose up --build
#
# Nothing here is secret in a local demo. POSTGRES_PASSWORD has no default on
# purpose: a stack that silently starts with a guessable database password is
# worse than one that refuses to start.

# --- required -------------------------------------------------------------
POSTGRES_PASSWORD=change_me

# --- optional -------------------------------------------------------------
POSTGRES_DB=sdi
POSTGRES_USER=postgres
WEB_PORT=3000
WORKER_PORT=3001

# 1 bakes sql/99_local_logins.sql into the image so the demo roles can log in.
# Set to 0 for anything real: the application roles then carry no password of
# their own and take credentials from the deployment instead.
DEMO_LOGINS=1
SDI_APP_PASSWORD=demo_app_pw
SDI_INTEGRATION_PASSWORD=demo_int_pw

# --- the worker only (COMPOSE_PROFILES=worker) ----------------------------
# A Private Integration Token is scoped to an ENTIRE GoHighLevel sub-account.
# Keep it here or in Portainer's environment panel, never in a committed file.
COMPOSE_PROFILES=
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_WEBHOOK_PUBLIC_KEY=
