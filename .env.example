# Copy to .env, or paste these into Portainer's stack environment panel.
#
#   cp .env.example .env && docker compose up --build
#
# Nothing here is secret in a local demo. POSTGRES_PASSWORD has no default on
# purpose: a stack that silently starts with a guessable database password is
# worse than one that refuses to start.

# --- required -------------------------------------------------------------
POSTGRES_PASSWORD=change_me
# Given to the sdi_app role at first start. Without it the web tier cannot
# connect at all -- the role stays NOLOGIN, which fails visibly.
SDI_APP_PASSWORD=demo_app_pw

# --- optional -------------------------------------------------------------
POSTGRES_DB=sdi
POSTGRES_USER=postgres
WEB_PORT=3000
WORKER_PORT=3001

# Only needed when running the worker.
SDI_INTEGRATION_PASSWORD=demo_int_pw

# Release image tag, used by docker-compose.release.yml only. Pin this to a
# version for anything real; `latest` moves whenever main does.
SDI_VERSION=latest

# WHERE THIS HOST KEEPS THE PHOTOGRAPHS. A host path, and per-host: it is
# expected to differ between machines and there is nothing to keep in step.
# The container always sees /srv/media whatever this says, and the database
# stores paths relative to that, so moving the store is a change to this one
# line -- no symlink, no migration, nothing in the data to rewrite.
#
# A host directory rather than a named volume on purpose: `docker compose
# down -v` destroys named volumes, and a schema change needs `down -v`.
# Photographs must not die with a database rebuild.
#
# If you point this at a separate filesystem, PUT THAT FILESYSTEM IN
# /etc/fstab. Unmounted at boot, Docker bind-mounts the empty mountpoint
# directory underneath it instead -- silently, with no error -- and every
# photograph appears to have vanished while the database still lists them.
#
# It must be writable by uid 1000: the web container runs as `node`.
SDI_MEDIA_DIR=./media

# A FILE THAT EXISTS ONLY ON THE MOUNTED STORE. Set this and the web tier
# refuses to start when it is missing.
#
# It exists because `nofail` in /etc/fstab -- which is the right setting on
# a remote host, since a volume that fails to attach must not cost you SSH
# -- means an absent volume is not an error. The host boots, the mount
# point stays an empty directory on the OS disk, Docker bind-mounts THAT
# without complaint, and there is no failed container and no warning
# anywhere. Uploads land on the wrong disk and every photograph already
# taken is missing from the application while the database still lists all
# of them. It looks like data loss, and nothing about it points at a mount.
#
# Leave EMPTY for local development against ./media -- there is nothing
# mounted and nothing to assert; the server says so at start-up rather than
# staying quiet about it.
#
# On a host with a real store, after checking the mount is up:
#   touch /mnt/sdi-media/.sdi-media-volume && chown 1000:1000 /mnt/sdi-media/.sdi-media-volume
SDI_MEDIA_SENTINEL=

# --- the search box's language model (optional) ---------------------------
# Without this the plain-English search falls back to its rules parser, which
# handles the ordinary searches on its own. With it, sentences the rules do
# not reach are turned into the same criteria object by Claude -- and are
# validated by exactly the same allowlist on the way out.
# Leave this EMPTY to run without it -- that is a supported state, not a
# degraded one. Do not leave a placeholder here: a non-empty value that is
# not a key makes every unparseable search wait out the API timeout before
# falling back. Empty, or a real sk-ant-... key. Nothing in between.
ANTHROPIC_API_KEY=
# Override to trade capability for cost. claude-haiku-4-5 is a great deal
# cheaper per search; which model runs is your call, not the code's.
SDI_LLM_MODEL=
SDI_LLM_TIMEOUT_MS=

# --- the worker only (COMPOSE_PROFILES=worker) ----------------------------
# A Private Integration Token is scoped to an ENTIRE GoHighLevel sub-account.
# Keep it here or in Portainer's environment panel, never in a committed file.
COMPOSE_PROFILES=
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_WEBHOOK_PUBLIC_KEY=
